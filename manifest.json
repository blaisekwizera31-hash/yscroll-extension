{
  "manifest_version": 3,
  "name": "Doomshield: Break the Cycle",
  "version": "2.0.1",
  "description": "Reclaim your time and focus. Doomshield helps you navigate away from endless scrolling and back to intentional living.",
  "key": "",

  "permissions": [
    "storage",
    "identity"
  ],

  "oauth2": {
    "client_id": "543225960170-n5709580num1b32qd0hguspjg39o6s0t.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },

  "optional_host_permissions": [
    "<all_urls>"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.tiktok.com/*",
    "*://*.linkedin.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.x.com/*",
    "https://www.googleapis.com/*",
    "https://doomshield.pages.dev/*",
    "https://doomshield.blaisekwizera31.workers.dev/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/doomshield-16.png",
      "48": "icons/doomshield-48.png",
      "128": "icons/doomshield-128.png"
    }
  },

  "icons": {
    "16": "icons/doomshield-16.png",
    "48": "icons/doomshield-48.png",
    "128": "icons/doomshield-128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "externally_connectable": {
    "matches": [
      "https://doomshield.pages.dev/*",
      "https://doomshield.blaisekwizera31.workers.dev/*"
    ]
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "contentScripts/shared.js",
        "contentScripts/youtube.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": [
        "contentScripts/shared.js",
        "contentScripts/tiktok.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": [
        "contentScripts/shared.js",
        "contentScripts/linkedin.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": [
        "contentScripts/shared.js",
        "contentScripts/instagram.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": [
        "contentScripts/shared.js",
        "contentScripts/facebook.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.x.com/*"],
      "js": [
        "contentScripts/shared.js",
        "contentScripts/x.js"
      ],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "icons/*",
        "fonts/*.ttf"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.tiktok.com/*",
        "*://*.linkedin.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.x.com/*"
      ]
    }
  ]
}
